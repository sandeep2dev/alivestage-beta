# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:5001

# Supabase (database + storage — auth is custom OTP)
# Do NOT set SUPABASE_DB or SUPABASE_DB_PASSWORD — they break `npx supabase db push`
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (OTP JWT)
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=5001

# Razorpay (collection-only fees: ₹200 host create, ₹50 join)
# When NEXT_PUBLIC_APP_URL is localhost, only rzp_test_* keys are used (test mode).
# Optional overrides: RAZORPAY_TEST_KEY_ID/SECRET (local) and RAZORPAY_LIVE_KEY_ID/SECRET (prod).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Webhook signing secret (Dashboard → Webhooks). Falls back to KEY_SECRET in dev.
RAZORPAY_WEBHOOK_SECRET=

# Discord support (incoming webhook) — Help dialog posts here
# Leave empty to log messages in the API console instead
DISCORD_SUPPORT_WEBHOOK_URL=

# SMTP (Nodemailer) — used for email OTP and notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sandeep@alivestage.com
